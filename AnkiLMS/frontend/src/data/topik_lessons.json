[
  {
    "id": "lesson_1",
    "lessonNum": 1,
    "title": "Bài 1: Đi tàu điện ngầm & Di chuyển",
    "topikLevel": 1,
    "topikName": "TOPIK 1",
    "startSec": 0.0,
    "endSec": 76.9,
    "durationSec": 76.9,
    "segmentCount": 13,
    "segments": [
      {
        "id": 1,
        "start": 0.0,
        "end": 2.96,
        "text": "안녕하세요. Talk To Me In Korean의 유승환입니다."
      },
      {
        "id": 2,
        "start": 2.96,
        "end": 9.36,
        "text": "오늘은 한국에서 가장 유명한 관광지 중에 한 곳을 가볼 거예요."
      },
      {
        "id": 3,
        "start": 9.36,
        "end": 12.8,
        "text": "바로 경복궁입니다."
      },
      {
        "id": 4,
        "start": 12.8,
        "end": 16.0,
        "text": "가보신 분들도 있을 것 같은데"
      },
      {
        "id": 5,
        "start": 16.0,
        "end": 21.2,
        "text": "경복궁은 옛날 왕들이 살면서 일했던 곳이에요."
      },
      {
        "id": 6,
        "start": 21.2,
        "end": 26.08,
        "text": "미국의 백악관 같은 곳이라고 할 수 있어요."
      },
      {
        "id": 7,
        "start": 26.08,
        "end": 29.2,
        "text": "어, 신호등 바뀌었다."
      },
      {
        "id": 8,
        "start": 29.2,
        "end": 51.86,
        "text": "건너에 지금 그래서 지하철을 타러 가고 있습니다."
      },
      {
        "id": 9,
        "start": 51.86,
        "end": 55.62,
        "text": "저는 지금 홍대 입구에 있고요."
      },
      {
        "id": 10,
        "start": 55.62,
        "end": 60.82,
        "text": "제가 가야 할 곳은 여기 경복궁 여기예요."
      },
      {
        "id": 11,
        "start": 60.82,
        "end": 68.18,
        "text": "그래서 하나, 둘, 셋, 넷, 다섯, 여섯, 일곱."
      },
      {
        "id": 12,
        "start": 68.18,
        "end": 73.06,
        "text": "일곱 정거장을 가서 을지로 삼가역에서"
      },
      {
        "id": 13,
        "start": 73.06,
        "end": 76.9,
        "text": "이 주황색 선으로 갈아타야 돼요."
      }
    ]
  },
  {
    "id": "lesson_2",
    "lessonNum": 2,
    "title": "Bài 2: Đi tàu điện ngầm & Di chuyển",
    "topikLevel": 1,
    "topikName": "TOPIK 1",
    "startSec": 76.98,
    "endSec": 153.84,
    "durationSec": 76.9,
    "segmentCount": 13,
    "segments": [
      {
        "id": 14,
        "start": 76.98,
        "end": 82.26,
        "text": "그다음에 하나, 둘, 셋, 세 정거장을 더 가면 돼요."
      },
      {
        "id": 15,
        "start": 82.26,
        "end": 85.86,
        "text": "신촌 쪽으로 가는 걸 타야겠네요."
      },
      {
        "id": 16,
        "start": 85.86,
        "end": 92.22,
        "text": "홍대 입구에서 신촌으로 가는 걸 타야 되고"
      },
      {
        "id": 17,
        "start": 92.22,
        "end": 102.96,
        "text": "합정으로 가는 거 타면 안 돼요."
      },
      {
        "id": 18,
        "start": 102.96,
        "end": 106.16,
        "text": "방금 을지로 삼가역에 내렸어요."
      },
      {
        "id": 19,
        "start": 106.16,
        "end": 109.68,
        "text": "보시면 갈아타는 곳이라고 써 있고 화살표가 있죠?"
      },
      {
        "id": 20,
        "start": 109.68,
        "end": 114.61,
        "text": "이걸 따라가면 돼요."
      },
      {
        "id": 21,
        "start": 114.61,
        "end": 119.39,
        "text": "이제 3호선 타는 곳에 거의 도착했어요."
      },
      {
        "id": 22,
        "start": 119.39,
        "end": 121.63,
        "text": "경복궁 써 있네요."
      },
      {
        "id": 23,
        "start": 135.66,
        "end": 138.62,
        "text": "경복궁역에 내렸어요."
      },
      {
        "id": 24,
        "start": 138.62,
        "end": 144.54,
        "text": "경복궁역에서 경복궁과 가장 가까운 출구는 5번 출구예요."
      },
      {
        "id": 25,
        "start": 144.54,
        "end": 151.84,
        "text": "그래서 5번 출구로 나가볼게요."
      },
      {
        "id": 26,
        "start": 151.84,
        "end": 153.84,
        "text": "출구 찾는 방법."
      }
    ]
  },
  {
    "id": "lesson_3",
    "lessonNum": 3,
    "title": "Bài 3: Tham quan Hoàng Cung 경복궁",
    "topikLevel": 1,
    "topikName": "TOPIK 1",
    "startSec": 153.92,
    "endSec": 235.71,
    "durationSec": 81.8,
    "segmentCount": 15,
    "segments": [
      {
        "id": 27,
        "start": 153.92,
        "end": 156.4,
        "text": "일단 숫자를 먼저 찾아야 돼요."
      },
      {
        "id": 28,
        "start": 156.4,
        "end": 158.72,
        "text": "여기 써 있네요."
      },
      {
        "id": 29,
        "start": 158.72,
        "end": 161.76,
        "text": "5번 출구는 오른쪽으로 가라고 써 있어요."
      },
      {
        "id": 30,
        "start": 161.76,
        "end": 165.26,
        "text": "경복궁도 써 있고요."
      },
      {
        "id": 31,
        "start": 165.26,
        "end": 168.22,
        "text": "5번 출구로 나오면 이런 모습이에요."
      },
      {
        "id": 32,
        "start": 169.58,
        "end": 171.58,
        "text": "헉! 잠깐만!"
      },
      {
        "id": 33,
        "start": 172.14,
        "end": 174.62,
        "text": "평일인데 이렇게 많다고 사람이?"
      },
      {
        "id": 34,
        "start": 175.9,
        "end": 179.18,
        "text": "저는 약간 텅 비어있을 줄 알았거든요."
      },
      {
        "id": 35,
        "start": 179.26,
        "end": 181.71,
        "text": "와..."
      },
      {
        "id": 36,
        "start": 181.71,
        "end": 187.63,
        "text": "한국인 관광객도 많고 외국인 관광객도 많은 것 같아요."
      },
      {
        "id": 37,
        "start": 187.63,
        "end": 192.11,
        "text": "아, 다들 뭔가 기다리고 있구나."
      },
      {
        "id": 38,
        "start": 192.11,
        "end": 197.07,
        "text": "다들 여기 서 있는데 아마 10시에 뭔가 시작되는 것 같아요."
      },
      {
        "id": 39,
        "start": 197.07,
        "end": 199.47,
        "text": "그래서 이렇게 다들 뭔가 기다리고 있어요."
      },
      {
        "id": 40,
        "start": 220.13,
        "end": 221.41,
        "text": "도착한 장소."
      },
      {
        "id": 41,
        "start": 233.55,
        "end": 235.71,
        "text": "네, 지금 표 사는 곳에 왔는데요."
      }
    ]
  },
  {
    "id": "lesson_4",
    "lessonNum": 4,
    "title": "Bài 4: Tham quan Hoàng Cung 경복궁",
    "topikLevel": 3,
    "topikName": "TOPIK 3",
    "startSec": 235.71,
    "endSec": 311.68,
    "durationSec": 76.0,
    "segmentCount": 25,
    "segments": [
      {
        "id": 42,
        "start": 235.71,
        "end": 237.71,
        "text": "줄을 서서 기다리고 있어요."
      },
      {
        "id": 43,
        "start": 239.07,
        "end": 242.35,
        "text": "줄이 정말 길고 사람들도 정말 많아요."
      },
      {
        "id": 44,
        "start": 242.35,
        "end": 246.7,
        "text": "안녕하세요."
      },
      {
        "id": 45,
        "start": 246.7,
        "end": 247.9,
        "text": "어른 한 명이요."
      },
      {
        "id": 46,
        "start": 247.9,
        "end": 249.26,
        "text": "감사합니다."
      },
      {
        "id": 47,
        "start": 249.26,
        "end": 253.3,
        "text": "현금 되나요?"
      },
      {
        "id": 48,
        "start": 253.3,
        "end": 254.1,
        "text": "감사합니다."
      },
      {
        "id": 49,
        "start": 254.1,
        "end": 256.82,
        "text": "혹시 근데 여기 몇 시까지 해요?"
      },
      {
        "id": 50,
        "start": 256.82,
        "end": 258.82,
        "text": "들어가시는 분은 5시까지."
      },
      {
        "id": 51,
        "start": 258.82,
        "end": 260.5,
        "text": "5시까지 입장 가능해요?"
      },
      {
        "id": 52,
        "start": 260.5,
        "end": 261.78,
        "text": "알람은 6시까지."
      },
      {
        "id": 53,
        "start": 261.78,
        "end": 263.78,
        "text": "아, 네. 알겠습니다. 감사합니다."
      },
      {
        "id": 54,
        "start": 263.78,
        "end": 264.82,
        "text": "가위바위보."
      },
      {
        "id": 55,
        "start": 264.82,
        "end": 266.58,
        "text": "네, 표를 현장 샀습니다."
      },
      {
        "id": 56,
        "start": 266.58,
        "end": 268.02,
        "text": "이제 들어가 볼게요."
      },
      {
        "id": 57,
        "start": 277.2,
        "end": 279.2,
        "text": "정신이 하나도 없는데."
      },
      {
        "id": 58,
        "start": 280.32,
        "end": 283.6,
        "text": "보면 이렇게 한복을 입고 계신 분들이 많은데"
      },
      {
        "id": 59,
        "start": 284.24,
        "end": 285.6,
        "text": "이유가 있어요."
      },
      {
        "id": 60,
        "start": 285.6,
        "end": 290.48,
        "text": "한복을 입으면 경복궁에 무료로 입장할 수 있어요."
      },
      {
        "id": 61,
        "start": 290.48,
        "end": 294.88,
        "text": "그래서 저는 3천 원을 내고 들어왔지만"
      },
      {
        "id": 62,
        "start": 294.96,
        "end": 298.08,
        "text": "한복을 입고 있으면 이 3천 원을 내지 않아도"
      },
      {
        "id": 63,
        "start": 298.08,
        "end": 300.08,
        "text": "여기 들어올 수 있어요."
      },
      {
        "id": 64,
        "start": 300.08,
        "end": 302.08,
        "text": "그래서 경복궁에 오면"
      },
      {
        "id": 65,
        "start": 302.08,
        "end": 305.04,
        "text": "한복 입은 사람들을 정말 많이 볼 수 있어요."
      },
      {
        "id": 66,
        "start": 307.04,
        "end": 311.68,
        "text": "이게 경복궁에서 가장 큰 건물인데"
      }
    ]
  },
  {
    "id": "lesson_5",
    "lessonNum": 5,
    "title": "Bài 5: Luyện nghe giao tiếp #5",
    "topikLevel": 3,
    "topikName": "TOPIK 3",
    "startSec": 311.68,
    "endSec": 388.46,
    "durationSec": 76.8,
    "segmentCount": 22,
    "segments": [
      {
        "id": 67,
        "start": 311.68,
        "end": 314.08,
        "text": "아마 한국 사람들이"
      },
      {
        "id": 68,
        "start": 314.08,
        "end": 317.28,
        "text": "궁하면 제일 먼저 떠올리는 게"
      },
      {
        "id": 69,
        "start": 317.28,
        "end": 324.14,
        "text": "이런 이미지일 거예요."
      },
      {
        "id": 70,
        "start": 324.14,
        "end": 330.75,
        "text": "아는 이렇게 생겼어요."
      },
      {
        "id": 71,
        "start": 330.75,
        "end": 333.39,
        "text": "다른 분들도 보셔야 되니까"
      },
      {
        "id": 72,
        "start": 333.95,
        "end": 336.59,
        "text": "너무 한 자리에 오래 있으면 안 될 것 같아요."
      },
      {
        "id": 73,
        "start": 336.59,
        "end": 341.47,
        "text": "제 기억에는 저쪽에 호수 같은 게 있었거든요."
      },
      {
        "id": 74,
        "start": 341.47,
        "end": 352.46,
        "text": "그쪽으로 한번 가볼게요."
      },
      {
        "id": 75,
        "start": 352.46,
        "end": 356.24,
        "text": "사진 찍어줄까요?"
      },
      {
        "id": 76,
        "start": 356.24,
        "end": 359.58,
        "text": "좀 모여보세요."
      },
      {
        "id": 77,
        "start": 359.58,
        "end": 361.58,
        "text": "하나, 둘, 셋."
      },
      {
        "id": 78,
        "start": 361.58,
        "end": 363.58,
        "text": "한번 더 찍을게요."
      },
      {
        "id": 79,
        "start": 363.58,
        "end": 365.58,
        "text": "가로로."
      },
      {
        "id": 80,
        "start": 365.58,
        "end": 367.58,
        "text": "하나, 둘, 셋."
      },
      {
        "id": 81,
        "start": 367.58,
        "end": 369.58,
        "text": "네, 여기요."
      },
      {
        "id": 82,
        "start": 369.58,
        "end": 371.58,
        "text": "감사합니다."
      },
      {
        "id": 83,
        "start": 371.58,
        "end": 373.58,
        "text": "중학생인 것 같은데"
      },
      {
        "id": 84,
        "start": 373.82,
        "end": 377.98,
        "text": "셀카로만 찍고 있어서 찍어줬어요."
      },
      {
        "id": 85,
        "start": 377.98,
        "end": 379.98,
        "text": "수학여행으로 온 것 같아요."
      },
      {
        "id": 86,
        "start": 379.98,
        "end": 383.18,
        "text": "아까 큰 건물인 근정전에서"
      },
      {
        "id": 87,
        "start": 383.18,
        "end": 385.18,
        "text": "왼쪽으로 오면"
      },
      {
        "id": 88,
        "start": 385.18,
        "end": 388.46,
        "text": "작은 공원과 연못이 있어요."
      }
    ]
  },
  {
    "id": "lesson_6",
    "lessonNum": 6,
    "title": "Bài 6: Tham quan Hoàng Cung 경복궁",
    "topikLevel": 3,
    "topikName": "TOPIK 3",
    "startSec": 388.46,
    "endSec": 465.39,
    "durationSec": 76.9,
    "segmentCount": 29,
    "segments": [
      {
        "id": 89,
        "start": 388.46,
        "end": 390.94,
        "text": "여기도 사진 찍기가 정말 좋아서"
      },
      {
        "id": 90,
        "start": 390.94,
        "end": 394.3,
        "text": "보시면 벌써 많은 사람들이 서 있네요."
      },
      {
        "id": 91,
        "start": 394.3,
        "end": 396.3,
        "text": "여기 이런 연못이 있고"
      },
      {
        "id": 92,
        "start": 397.74,
        "end": 399.74,
        "text": "그리고 여기 있는 버드나무가"
      },
      {
        "id": 93,
        "start": 400.78,
        "end": 402.78,
        "text": "이 곳이랑 너무 잘 어울려요."
      },
      {
        "id": 94,
        "start": 404.61,
        "end": 406.61,
        "text": "사진 좀 찍어드릴까?"
      },
      {
        "id": 95,
        "start": 406.61,
        "end": 408.61,
        "text": "사진 찍어드릴까요 두 분?"
      },
      {
        "id": 96,
        "start": 408.61,
        "end": 410.61,
        "text": "사진 찍어드릴까요?"
      },
      {
        "id": 97,
        "start": 410.61,
        "end": 414.61,
        "text": "핸드폰 주시면 제가 찍어드릴게요."
      },
      {
        "id": 98,
        "start": 414.61,
        "end": 416.61,
        "text": "네, 저 주세요."
      },
      {
        "id": 99,
        "start": 416.61,
        "end": 420.75,
        "text": "하나, 둘, 셋."
      },
      {
        "id": 100,
        "start": 420.75,
        "end": 422.75,
        "text": "네."
      },
      {
        "id": 101,
        "start": 422.75,
        "end": 426.75,
        "text": "사진을 아주 예쁘게 잘 찍어드려서"
      },
      {
        "id": 102,
        "start": 426.75,
        "end": 428.75,
        "text": "되게 만족스러워 하실 것 같아요."
      },
      {
        "id": 103,
        "start": 428.75,
        "end": 430.75,
        "text": "여러분 경복궁 오셔서"
      },
      {
        "id": 104,
        "start": 430.75,
        "end": 432.75,
        "text": "진짜 저 메인 건물만 보고"
      },
      {
        "id": 105,
        "start": 432.75,
        "end": 434.75,
        "text": "그냥 가면 안 돼요."
      },
      {
        "id": 106,
        "start": 435.07,
        "end": 437.07,
        "text": "여기 꼭 오셔야 돼요."
      },
      {
        "id": 107,
        "start": 437.07,
        "end": 441.07,
        "text": "지금 벤치에 앉아서 쉬고 있는데"
      },
      {
        "id": 108,
        "start": 441.07,
        "end": 445.07,
        "text": "아까 혹시 배고파지면 먹으려고"
      },
      {
        "id": 109,
        "start": 445.07,
        "end": 449.07,
        "text": "가져왔던 간식이 생각나서"
      },
      {
        "id": 110,
        "start": 449.07,
        "end": 451.07,
        "text": "이거 아세요?"
      },
      {
        "id": 111,
        "start": 451.07,
        "end": 453.07,
        "text": "발리에 갔던 회사 동료분이"
