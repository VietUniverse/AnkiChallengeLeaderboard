    "segmentCount": 27,
    "segments": [
      {
        "id": 118,
        "start": 472.8,
        "end": 479.46,
        "text": "이게 날아가서 다시 주었어요."
      },
      {
        "id": 119,
        "start": 479.46,
        "end": 483.46,
        "text": "요즘 아침에는 춥고 낮에는 조금 덥고"
